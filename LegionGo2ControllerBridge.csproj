<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AssemblyName>LegionGo2ControllerBridge</AssemblyName>
    <RootNamespace>LegionGo2ControllerBridge</RootNamespace>
    <ApplicationIcon>assets\controller-bridge.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <DebugType>embedded</DebugType>
    <Version>0.1.0-alpha.1</Version>
    <AssemblyVersion>0.1.0.0</AssemblyVersion>
    <FileVersion>0.1.0.0</FileVersion>
    <Authors>Legion Go community contributors</Authors>
    <Description>Workaround for Legion Go 2 controller initialization and side-drawer routing defects.</Description>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="LegionGo2ControllerTray.cs" />
    <None Include="assets\controller-bridge.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
